# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Apify Configuration (Required for web scraping)
APIFY_API_KEY=your_apify_api_key

# Perplexity AI (Optional - for LLM-enhanced predictions)
PERPLEXITY_API_KEY=your_perplexity_api_key

# Anthropic Claude AI (Optional - for AI-powered insights)
# Get API key at: https://console.anthropic.com/
# Used by /api/predictions/ai-insights for intelligent analysis
ANTHROPIC_API_KEY=your_anthropic_api_key

# Tavily Search API (Optional - for internet research agent)
# Get free API key at: https://tavily.com
# Free tier: 1000 searches/month
# Used for gathering external market intelligence (events, news, trends)
TAVILY_API_KEY=your_tavily_api_key

# OpenWeather API (Optional - for weather-enhanced predictions)
# Get free API key at: https://openweathermap.org/api
# Free tier: 1000 calls/day, 5-day forecast
OPENWEATHER_API_KEY=your_openweather_api_key

# Next.js Configuration
NODE_ENV=development

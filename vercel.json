{
  "crons": [
    {
      "path": "/api/cron/auto-scan",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/monitor-scan",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/update-predictions",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/daily-predictions",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/cache-cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/learning/accuracy",
      "schedule": "0 3 * * *",
      "description": "Check prediction accuracy vs actuals - Daily at 3 AM"
    },
    {
      "path": "/api/learning/refresh-predictions",
      "schedule": "0 2 * * *",
      "description": "Refresh predictions for next 90 days - Daily at 2 AM"
    }
  ]
}
